{
  "name": "@claritas/node",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "*.node"
  ],
  "scripts": {
    "build": "export PATH=\"$HOME/.cargo/bin:$PATH\" && napi build --platform --release --cargo-cwd ../../crates/bindings-napi && tsc",
    "build:debug": "export PATH=\"$HOME/.cargo/bin:$PATH\" && napi build --platform --cargo-cwd ../../crates/bindings-napi && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18",
    "@types/node": "^22",
    "vitest": "^3"
  },
  "napi": {
    "name": "claritas",
    "triples": {
      "defaults": true
    }
  }
}
